{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-ground.invalid/specs/task_spec.schema.json",
  "title": "Virtual Ground Interpreter TaskSpec",
  "description": "Typed, bounded expression language compiled to VGI signal-state IR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "inputs", "outputs"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "expression"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "expression": {"$ref": "#/$defs/expression"}
        }
      }
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "address"],
          "properties": {"type": {"const": "input"}, "address": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "left", "right"],
          "properties": {"type": {"const": "add"}, "left": {"$ref": "#/$defs/expression"}, "right": {"$ref": "#/$defs/expression"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "left", "right"],
          "properties": {"type": {"const": "sub"}, "left": {"$ref": "#/$defs/expression"}, "right": {"$ref": "#/$defs/expression"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "value", "observer"],
          "properties": {"type": {"const": "reframe"}, "value": {"$ref": "#/$defs/expression"}, "observer": {"enum": [1, 3, 5, 7]}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "guard", "when_true", "when_false"],
          "properties": {
            "type": {"const": "if"},
            "guard": {"$ref": "#/$defs/guard"},
            "when_true": {"$ref": "#/$defs/expression"},
            "when_false": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "guard": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "value", "tolerance_rad"],
          "properties": {
            "type": {"const": "is_identity"},
            "value": {"$ref": "#/$defs/expression"},
            "tolerance_rad": {"type": "number", "minimum": 0, "maximum": 3.141592653589793}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "left", "right", "tolerance_rad"],
          "properties": {
            "type": {"const": "equal"},
            "left": {"$ref": "#/$defs/expression"},
            "right": {"$ref": "#/$defs/expression"},
            "tolerance_rad": {"type": "number", "minimum": 0, "maximum": 3.141592653589793}
          }
        }
      ]
    }
  }
}
